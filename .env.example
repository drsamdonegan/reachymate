APP_ENV=simulation
LOG_LEVEL=INFO
DB_URL=sqlite:///./data/office_bouncer.db
# URL-safe base64 for exactly 32 random bytes. Store in the deployment secret manager.
DATA_ENCRYPTION_KEY=
OFFICE_TIMEZONE=Australia/Melbourne
REACHY_ENABLED=false
REACHY_SIMULATION=true
PHYSICAL_UNLOCK_ENABLED=false
REACHY_HOST=127.0.0.1
REACHY_PORT=8000
REACHY_CONNECTION_MODE=auto
REACHY_CONNECTION_TIMEOUT_SECONDS=8
REACHY_MEDIA_BACKEND=lite_direct
REACHY_CAMERA_DEVICE_INDEX=1
SIMULATION_USE_WEBCAM=false
SIMULATION_USE_MICROPHONE=false
WAKEWORD_MODEL_PATH=./data/models/hey_reachy.onnx
WAKEWORD_ENGINE=sherpa_onnx
WAKE_PHRASE=hey reachy
SHERPA_KWS_MODEL_DIR=./data/models/sherpa-kws
SHERPA_KWS_KEYWORDS_PATH=./app/assets/hey_reachy.keywords
SHERPA_KWS_THRESHOLD=0.25
SHERPA_KWS_SCORE=1.5
WAKEWORD_VOSK_FALLBACK_ENABLED=false
VOSK_MODEL_PATH=./data/models/vosk-en
FACE_DETECTOR_MODEL_PATH=./data/models/face_detection_yunet.onnx
FACE_EMBEDDER_MODEL_PATH=./data/models/face_recognition_sface.onnx
TTS_ENGINE=simulation
MOTION_ASSETS_DIR=./data/movements

# Cloud voice opens after a local wake or explicit dashboard start. Keep disabled until the
# Reachy media path and key are provisioned and tested.
REALTIME_ENABLED=false
VOICE_API=gpt_live
OPENAI_API_KEY=
OPENAI_LIVE_URL=wss://api.openai.com/v1/live/sessions
OPENAI_LIVE_MODEL=gpt-live-1
OPENAI_LIVE_BACKEND_MODEL=gpt-6-luna
LIVE_CLOSE_TIMEOUT_SECONDS=5
LIVE_MAX_OUTPUT_BUFFER_SECONDS=1.0
LIVE_PLAYBACK_RESERVE_SECONDS=0.2
# Continuous microphone chat is available only on the staging shadow bench.
# The --demo launcher enables it; normal wake-word sessions remain face-gated.
ATTENDED_CHAT_ENABLED=false
ATTENDED_CHAT_MAX_SECONDS=600
# Opt-in still images for visual questions during attended chat; no video upload.
CAMERA_VISION_ENABLED=false
# Legacy Realtime is selectable explicitly with VOICE_API=realtime.
OPENAI_REALTIME_URL=wss://api.openai.com/v1/realtime
OPENAI_REALTIME_MODEL=gpt-realtime-2.1
OPENAI_REALTIME_VOICE=marin
OPENAI_REALTIME_REASONING_EFFORT=low
REALTIME_IDLE_TIMEOUT_SECONDS=45
REALTIME_MAX_SESSION_SECONDS=900
REALTIME_INPUT_QUEUE_CHUNKS=64
REALTIME_OPEN_TIMEOUT_SECONDS=10
REALTIME_VAD_THRESHOLD=0.8
REALTIME_VAD_PREFIX_PADDING_MS=300
REALTIME_VAD_SILENCE_DURATION_MS=600
REALTIME_INITIAL_OUTPUT_SETTLE_MS=800
DEVICE_ID=reachy-lobby
MLAI_BACKEND_URL=http://localhost:8091
MLAI_BACKEND_API_KEY=local-dev-key
MLAI_PUBLIC_KNOWLEDGE_TOKEN=
MLAI_PUBLIC_KNOWLEDGE_TIMEOUT_SECONDS=3
MLAI_ORGANIZATION_DOMAIN=
SLACK_SIGNING_SECRET=
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
FACE_MATCH_THRESHOLD=0.48
WAKEWORD_THRESHOLD=0.5
VAD_THRESHOLD=0.5
AUDIO_PROCESSING_ENABLED=true
AUDIO_AEC_STREAM_DELAY_MS=10
AUDIO_NOISE_SUPPRESSION_LEVEL=3
VAD_MODEL_PATH=./data/models/silero_vad.onnx
BOOKING_GRACE_MINUTES=0
ENGAGEMENT_TIMEOUT_SECONDS=8
COOLDOWN_SECONDS=4
UNLOCK_IDEMPOTENCY_SECONDS=20
FACE_IDENTIFICATION_TIMEOUT_SECONDS=5
BOOKING_LOOKUP_TIMEOUT_SECONDS=5
DOOR_ACTION_TIMEOUT_SECONDS=2
MIN_FACE_SIZE=152
MIN_BLUR_SCORE=60
MIN_BRIGHTNESS=60
ALLOW_DEV_ENDPOINTS=false
HEALTH_FRESHNESS_SECONDS=30
HEALTH_PROBE_INTERVAL_SECONDS=10

# All active runtime deployments remain non-actuating.
HOST=127.0.0.1
ACCESS_MODE=shadow
DOOR_STAGE=0
IDENTIFICATION_MODE=request_scoped
REALTIME_SAFETY_IDENTIFIER_KEY=
REALTIME_OUTPUT_QUEUE_CHUNKS=64
REALTIME_TOOL_LIMIT=20
ENGAGEMENT_SILENCE_SECONDS=20
CONSENT_TIMEOUT_SECONDS=8
FACE_UNKNOWN_THRESHOLD=0.30
FACE_MATCH_MARGIN=0.08
MAX_BRIGHTNESS=200
ATTENDED_DEMO=false
ATTENDED_DEMO_EXPIRES_AT=0
REACHY_INPUT_CHANNEL=mean
REACHY_CAMERA_NAME=Reachy Mini Camera
REACHY_CAMERA_UNIQUE_ID=
CAMERA_CALIBRATION_PATH=
DOA_BEARING_VALIDATED=false
XVF_PROFILE=factory
AV_GATE_MODE=demo
DITHER_VALIDATED=false
LOCAL_BARGE_IN_ENABLED=false
AV_ZERO_TAIL_ENABLED=false
# Optional local assets require verified hashes and operator evaluation.
MOUTH_LANDMARKER_PATH=
MOUTH_LANDMARKER_SHA256=
GTCRN_MODEL_PATH=
FRONTDESK_URL=http://127.0.0.1:8092
FRONTDESK_TOKEN=
FRONTDESK_TRANSPORT=http
FRONTDESK_POLL_SECONDS=3
FRONTDESK_WAIT_SECONDS=120
ROUTING_ENABLED=true
SALTO_AUTH_BASE_URL=https://identity.eu.my-clay.com
# Obtain a confirmed API origin; this client is never composed by the runtime.
SALTO_API_BASE_URL=
KEK_ENDPOINT=
KIOSK_DEVICE_CREDENTIAL=
DATA_KEY_ENVELOPE_PATH=
