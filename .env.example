APP_ENV=development
LOG_LEVEL=INFO
DB_URL=sqlite:///./data/office_bouncer.db
OFFICE_TIMEZONE=Australia/Melbourne
REACHY_ENABLED=false
REACHY_SIMULATION=true
SIMULATION_USE_WEBCAM=false
SIMULATION_USE_MICROPHONE=false
WAKEWORD_MODEL_PATH=./data/models/hey_reachy.onnx
VOSK_MODEL_PATH=./data/models/vosk-en
TTS_ENGINE=simulation
MLAI_BACKEND_URL=http://localhost:8091
MLAI_BACKEND_API_KEY=local-dev-key
SLACK_SIGNING_SECRET=
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
SALTO_CLIENT_ID=
SALTO_CLIENT_SECRET=
SALTO_USERNAME=
SALTO_PASSWORD=
SALTO_AUTH_BASE_URL=https://api.saltoks.com
SALTO_API_BASE_URL=https://api.saltoks.com
SALTO_REDIRECT_URI=http://localhost:8080/api/admin/salto/oauth/callback
SALTO_SITE_ID=
SALTO_LOCK_ID=
FACE_MATCH_THRESHOLD=0.36
WAKEWORD_THRESHOLD=0.5
VAD_THRESHOLD=0.5
BOOKING_GRACE_MINUTES=0
ENGAGEMENT_TIMEOUT_SECONDS=8
COOLDOWN_SECONDS=4
UNLOCK_IDEMPOTENCY_SECONDS=20
MIN_FACE_SIZE=96
MIN_BLUR_SCORE=80
MIN_BRIGHTNESS=40
ALLOW_DEV_ENDPOINTS=true
